# Copier en .env puis changer les valeurs. Le .env n'est jamais commité.

# Base de données
POSTGRES_USER=helpdesk
POSTGRES_DB=helpdesk
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me-too

# Sauvegardes
BACKUP_INTERVAL=3600    # secondes entre deux sauvegardes
BACKUP_KEEP=7           # nombre de sauvegardes conservées
